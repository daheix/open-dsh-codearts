{
  "name": "dsh-codearts",
  "version": "0.3.2",
  "description": "华为云 CodeArts CLI 的 dsh（DeepSeek Harness）集成插件：PTY 终端托管、目标监督续跑、模型配置界面、HTTP 管理 API",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src-client",
    "scripts",
    "tsconfig.json",
    "cordis.patch.yml",
    "manage.sh",
    "install.sh",
    "package.json"
  ],
  "scripts": {
    "test": "bun test test/dsh-codearts.test.ts",
    "build:client": "bun scripts/build-client.mjs",
    "typecheck": "bun scripts/build-client/node_modules/typescript/lib/tsc.js -p tsconfig.json"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "license": "MIT",
  "author": "daheix",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daheix/open-dsh-codearts.git"
  },
  "homepage": "https://github.com/daheix/open-dsh-codearts#readme",
  "bugs": {
    "url": "https://github.com/daheix/open-dsh-codearts/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "codearts",
    "huawei",
    "plugin",
    "terminal",
    "pty",
    "goal-supervision"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  }
}
